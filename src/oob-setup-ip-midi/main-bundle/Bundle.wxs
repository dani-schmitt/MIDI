<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util"
     >

    <?define DependenciesSourceRootFolder=$(env.MIDI_REPO_ROOT)\build\dependencies ?>
    <?define StagingSourceRootFolder=$(env.MIDI_REPO_ROOT)build\staging ?>
    <?define StagingVersionIncludeFile=$(StagingSourceRootFolder)\version\BundleInfo.wxi ?>

    <?include $(StagingVersionIncludeFile) ?>


    <Bundle Name="$(var.IpMidiBundleName)"
            Manufacturer="nerds.de"
            Version="$(var.IpMidiBundleVersion)"
            UpgradeCode="$(var.IpMidiBundleUpgradeCode)">

        <?if $(var.IpMidiEdition) = Trial ?>
        <RelatedBundle Id="$(var.IpMidiRetailBundleUpgradeCode)" Action="detect" />
        <Variable Name="IpMidiRetailProductState" Type="numeric" Value="2" />
        <util:ProductSearch
            Id="IpMidiRetailProductSearch"
            UpgradeCode="$(var.IpMidiRetailMsiUpgradeCode)"
            Variable="IpMidiRetailProductState"
            Result="state" />
        <bal:Condition Message="The Retail edition of ipMIDI Ethernet Ports for MIDI Services is already installed. Uninstall it before installing the Trial edition."
                       Condition="WixBundleInstalled OR NOT (IpMidiRetailProductState = 5)" />
        <?else?>
        <RelatedBundle Id="$(var.IpMidiTrialBundleUpgradeCode)" Action="upgrade" />
        <?endif?>

        <!-- Require Dev Mode to be turned on to run this installer -->
        <WixVariable Id="DevModeEnabled" Value="0" />
        <util:RegistrySearch
            Id="DevMode"
            Root="HKLM"
            Key="SOFTWARE\Microsoft\Windows\CurrentVersion\AppModelUnlock"
            Value="AllowDevelopmentWithoutDevLicense"
            Variable="DevModeEnabled"
            Result="value"/>

        <bal:Condition Message="Developer mode in Windows Settings must be enabled to install ipMIDI Ethernet Ports for MIDI Services."
                 Condition="DevModeEnabled=1" />

        <WixVariable Id="WixUIDialogBmp" Value="midi_installer_logo.bmp" />

        <BootstrapperApplication>
            <bal:WixStandardBootstrapperApplication LicenseUrl=""
                                                    Theme="hyperlinkLicense"
                                                    SuppressOptionsUI="true"
                                                    SuppressRepair="true"
                                                    ShowVersion="true"
                                                    LogoFile="midi_installer_logo_square.png"/>


        </BootstrapperApplication>

        <Chain>
          <PackageGroupRef Id="Prerequisites" />
          <PackageGroupRef Id="MidiServicesPackages" />
        </Chain>
    </Bundle>


    <Fragment>
      <PackageGroup Id="Prerequisites">

        <!-- C++ Runtime. The x64 download contains both Arm64 and X64 versions -->
        <ExePackage
            Vital="false"
            DisplayName="Microsoft Visual C++ Runtime"
            SourceFile="$(DependenciesSourceRootFolder)\VC_redist.x64.exe"
            Compressed="yes"
            InstallArguments="/install /passive /norestart /log midi_vcruntime_install_log.txt"
            Permanent="true"
                >
        </ExePackage>

      </PackageGroup>

      <PackageGroup Id="MidiServicesPackages">
            <MsiPackage
                Id="$(var.IpMidiMsiOutputName)"
                Vital="true"
                Permanent="no"
                Visible="no"
                Compressed="yes"
                SourceFile="$(var.IpMidiMsiOutputName).msi">
                <?if $(var.IpMidiEdition) = Retail ?>
                <MsiProperty Name="IPMIDI_BURN_CROSS_EDITION" Value="1" />
                <?endif?>
            </MsiPackage>

        </PackageGroup>

    </Fragment>
</Wix>
