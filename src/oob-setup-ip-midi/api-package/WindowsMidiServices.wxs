<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util='http://wixtoolset.org/schemas/v4/wxs/util'>

    <?define StagingSourceRootFolder=$(var.IpMidiStagingRoot) ?>

    <Package
          Name="$(var.IpMidiPackageName)"
          Manufacturer="nerds.de"
          Version="$(var.IpMidiMsiVersion)"
          UpgradeCode="$(var.IpMidiMsiUpgradeCode)"
          Scope="perMachine"
          Compressed="true"

          >

        <MediaTemplate EmbedCab="yes" />

        <MajorUpgrade
            DowngradeErrorMessage="A newer version of ipMIDI Ethernet Ports for MIDI Services is already installed." />

        <?if $(var.IpMidiEdition) = Trial ?>
        <Upgrade Id="$(var.IpMidiRetailMsiUpgradeCode)">
            <UpgradeVersion Minimum="0.0.0"
                            IncludeMinimum="yes"
                            OnlyDetect="yes"
                            Property="IPMIDI_RETAIL_EDITION_FOUND" />
        </Upgrade>
        <Launch Condition="Installed OR NOT IPMIDI_RETAIL_EDITION_FOUND"
                Message="The Retail edition of ipMIDI Ethernet Ports for MIDI Services is already installed. Uninstall it, then use ipMIDITrialSetup.exe to install the Trial edition." />
        <?else?>
        <Property Id="IPMIDI_BURN_CROSS_EDITION" Secure="yes" />
        <Upgrade Id="$(var.IpMidiTrialMsiUpgradeCode)">
            <UpgradeVersion Minimum="0.0.0"
                            IncludeMinimum="yes"
                            Property="IPMIDI_TRIAL_EDITION_FOUND" />
        </Upgrade>
        <Launch Condition="Installed OR NOT IPMIDI_TRIAL_EDITION_FOUND OR IPMIDI_BURN_CROSS_EDITION = 1"
                Message="The Trial edition of ipMIDI Ethernet Ports for MIDI Services is installed. Use ipMIDISetup.exe to replace it with the Retail edition." />
        <?endif?>


        <StandardDirectory Id="ProgramFiles64Folder">
            <Directory Id="ROOTINSTALLFOLDER" Name="Windows MIDI Services">
                <Directory Id="SERVICE_INSTALLFOLDER" Name="Service" />
            </Directory>
        </StandardDirectory>

        <!-- Transport and other Service Plugins -->
        <!-- Setting the SelfRegCost attribute to any positive number causes DLL Self Registration -->

        <Component Id="WindowsServicePlugins"
                   Bitness="always64"
                   Directory="SERVICE_INSTALLFOLDER"
                   Guid="$(var.IpMidiServicePluginsComponentGuid)"  >

            <File Source="$(StagingSourceRootFolder)\api\$(var.Platform)\Midi2.IpMidiTransport.dll" SelfRegCost="1" Vital="true" />
            <File Source="$(StagingSourceRootFolder)\api\$(var.Platform)\Midi2.IpMidiTransport.pdb" />
        </Component>


        <Component Id="ConfigurationRegistryEntries"
                Bitness="always64"
                Directory="SERVICE_INSTALLFOLDER"
                Guid="$(var.IpMidiConfigurationComponentGuid)"
                NeverOverwrite="false">

            <RegistryKey Root="HKLM"
                         Key="SOFTWARE\Microsoft\Windows MIDI Services">

                <RegistryKey Key="Endpoint Processing Plugins">
                    <!-- TODO: Any processing plugins -->
                </RegistryKey>

                <RegistryKey Key="Transport Plugins">

                  <!-- Permissions users: Everyone, Administrators, LocalSystem, LocalService, NetworkService, AuthenticatedUser, Guests, CREATOR OWNER, INTERACTIVE, and Users -->

                    <RegistryKey Key="Midi2IpMidiTransport">
                        <RegistryValue Type="string" Name="CLSID" Value="{4F4E3D10-2768-429A-92F0-AAA0E8E2AC5E}">
                          <util:PermissionEx Read="yes" User="Everyone"/>
                          <util:PermissionEx GenericAll="yes" User="AuthenticatedUser"/>
                        </RegistryValue>
                        <RegistryValue Type="integer" Name="Enabled" Value="1">
                          <util:PermissionEx Read="yes" User="Everyone"/>
                          <util:PermissionEx GenericAll="yes" User="AuthenticatedUser"/>
                        </RegistryValue>
                    </RegistryKey>


                </RegistryKey>
            </RegistryKey>
        </Component>

      <Component Id="RestartService"
                  Bitness="always64"
                  Directory="SERVICE_INSTALLFOLDER"
                  Guid="$(var.IpMidiRestartServiceComponentGuid)">

        <ServiceControl Id="midisrv" Name="midisrv"
                        Start="both"
                        Stop="both"/>

      </Component>


      <Feature Id="WindowsMIDIServices">
        <ComponentRef Id="WindowsServicePlugins"/>
        <ComponentRef Id="ConfigurationRegistryEntries"/>
        <ComponentRef Id="RestartService"/>
      </Feature>


      <Binary Id="CustomActionBinary"
              SourceFile="$(var.customactions.TargetDir)$(var.customactions.TargetName).CA.dll" />

      <CustomAction Id="Action_TakeRegistryOwnership"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="TakeRegistryOwnership"
                    Return="check"/>

      <CustomAction Id="Action_ConfigureMidiServiceForIpMidi"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="ConfigureMidiServiceForIpMidi"
                    Return="check"/>

      <CustomAction Id="Action_ConfigureIpMidiFirewallRules"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="ConfigureIpMidiFirewallRules"
                    Return="check"/>

      <CustomAction Id="Action_InitializeIpMidiRegistryValues"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="InitializeIpMidiRegistryValues"
                    Return="check"/>

      <CustomAction Id="Action_RemoveIpMidiFirewallRules"
                    Impersonate="no"
                    Execute="deferred"
                    BinaryRef="CustomActionBinary"
                    DllEntry="RemoveIpMidiFirewallRules"
                    Return="ignore"/>

      <InstallExecuteSequence>
        <Custom Action="Action_TakeRegistryOwnership"
                Before="CreateFolders"
                Condition='(NOT Installed) AND NOT (REMOVE="ALL")' />

        <Custom Action="Action_ConfigureMidiServiceForIpMidi"
                After="StopServices"
                Condition='NOT (REMOVE="ALL")' />

        <Custom Action="Action_ConfigureIpMidiFirewallRules"
                After="Action_InitializeIpMidiRegistryValues"
                Condition='NOT (REMOVE="ALL")' />

        <Custom Action="Action_InitializeIpMidiRegistryValues"
                After="Action_ConfigureMidiServiceForIpMidi"
                Condition='NOT (REMOVE="ALL")' />

        <Custom Action="Action_RemoveIpMidiFirewallRules"
                Before="RemoveFiles"
                Condition='REMOVE="ALL"' />

      </InstallExecuteSequence>

    </Package>
</Wix>
